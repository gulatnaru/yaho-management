DATABASE_URL=
DIRECT_URL=
AUTH_SECRET=
NEXTAUTH_URL=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Phase 18 예약 신청 완료 화면(입금 안내·채널 링크). 하나라도 없으면 공개 신청을 받지 않는다.
RESERVATION_APPLICATION_BANK_NAME=
RESERVATION_APPLICATION_BANK_ACCOUNT_NUMBER=
RESERVATION_APPLICATION_BANK_ACCOUNT_HOLDER=
YAHO_BLOG_URL=
YAHO_INSTAGRAM_URL=
YAHO_KAKAO_CHANNEL_URL=
# G2 카카오 알림 Dispatcher (server/kakao/dispatcher.ts)가 읽는 환경변수.
# 이름만 문서화한다 — 값 설정은 별도 승인 사항이며, 에이전트가 값을 만들거나
# 기록하지 않는다. DATABASE_URL은 위쪽에 이미 있다. VERCEL_ENV와 NODE_ENV는
# 플랫폼(Vercel/Node)이 설정한다. 값이 없으면 실 DB 경로는 403으로 막힌다.
KAKAO_DISPATCH_BEARER_SECRET=
KAKAO_PREVIEW_PROJECT_REF=
KAKAO_PRODUCTION_PROJECT_REF=
KAKAO_PREVIEW_DB_IDENTITY_SHA256=
KAKAO_SOLAPI_API_KEY=
KAKAO_SOLAPI_API_SECRET=
KAKAO_ALIMTALK_PF_ID=
KAKAO_ALIMTALK_TEMPLATE_ID=
KAKAO_RECIPIENT_KEY=

AI_SERVICE_OPENAI_API_KEY=
AI_SERVICE_SKILL_SECRET=
# AI 상담 Skill 헤더 secret 구분 (server/ai-service/transport.ts):
# AI_SERVICE_SKILL_SECRET은 운영 헤더값, AI_SERVICE_SKILL_TEST_SECRET은 콘솔
# 테스트 헤더값 전용이다. 두 값은 반드시 달라야 하며, 테스트 secret은
# Production에서는 인증되지 않는다. AI_SERVICE_TEST_SKILL_SECRET은 합성 테스트
# 라우트(/api/ai-service/v1/skill-test) 전용 별개 secret이다.
AI_SERVICE_SKILL_TEST_SECRET=
AI_SERVICE_BOT_ID=
