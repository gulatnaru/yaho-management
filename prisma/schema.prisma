//
// ALTER TABLE "ReservationApplicationLink"
//   ADD CONSTRAINT "reservation_application_link_token_length" CHECK (char_length("token") >= 32);
//
// ALTER TABLE "ReservationApplication"
//   ADD CONSTRAINT "reservation_application_text_not_blank" CHECK (childName/guardianName/guardianPhone/consentVersion 공백 금지),
//   (20260929073840 의 "reservation_application_required_consents" 는 ADR-055 migration 에서 제거했다 — 사진 공유는 선택)
//   ADD CONSTRAINT "reservation_application_required_terms" CHECK (
//     "programTermsAcknowledged" AND "privacyConsentAgreed" AND "legalGuardianConfirmed" AND "refundTermsAcknowledged"
//   ),  -- 20260929155124 에서 환불규정 확인을 추가해 다시 만들었다 (ADR-056)
//   ADD CONSTRAINT "reservation_application_personal_data_presence" CHECK (
//     파기 전 ⇒ 아이·보호자·관계 항목 모두 있음, 파기 후 ⇒ 해당 항목·요청사항 모두 NULL + 처리 대기 아님
