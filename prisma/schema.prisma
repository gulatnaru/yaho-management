// YAHO Management System — Prisma Schema (draft)
// 기준: REQUIREMENTS.md v2 / docs/DATABASE.md / docs/DECISIONS.md
//
// 원칙
// - 금액은 정수 KRW
// - 물리 삭제 대신 isActive / status 로 이력 보존
// - 민감 안전 정보는 ChildSafetyInfo 로 분리 (기본 조회에 include 금지)
// - 일부 제약은 Prisma 로 표현 불가하여 migration 에 raw SQL CHECK 로 추가한다 (파일 하단 참조)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum Role {
  ADMIN
  MANAGER
  TEACHER
}

enum UserAccountChangeType {
  CREATED
  EMAIL_CHANGED
  ROLE_CHANGED
  ACTIVE_CHANGED
  PASSWORD_RESET
}

enum Gender {
  MALE
  FEMALE
  UNSPECIFIED
}

enum RelationshipType {
  FRIEND
  SIBLING
  // 향후 BROTHER / SISTER 확장 가능
}

enum ConsentType {
  PRIVACY // 개인정보 수집·이용 (필수)
  SENSITIVE_INFO // 민감정보 수집 (필수, 별도 동의)
  PHOTO_SHARE // 활동 사진 보호자 공유 (필수)
  PHOTO_MARKETING // 활동 사진 홍보 활용 (선택)
}

enum ConsentAction {
  AGREED
  REVOKED
  DECLINED // 예약 신청에서 선택 동의를 하지 않음. 철회(REVOKED)와 구분한다 (ADR-055)
}

// 예약 신청서의 아이와의 관계(법정대리인 확인, ADR-055)
enum GuardianRelationship {
  FATHER
  MOTHER
  OTHER_LEGAL_GUARDIAN
}

enum ReservationApplicationStatus {
  SUBMITTED // 접수(처리 대기)
  CONFIRMED // 예약 확정
  REJECTED // 운영자 반려
  CANCELLED // 보호자 요청 취소
}

enum ProgramStatus {
  ACTIVE
  INACTIVE
}

enum ClassStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum ClassCancelReason {
  WEATHER
  SAFETY
  MINIMUM_ENROLLMENT
  OPERATION
  OTHER
}

enum ReservationStatus {
  RESERVED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum ReservationCancelReason {
  PERSONAL
  ILLNESS
  SCHEDULE
  WEATHER
  DUPLICATE
  OPERATION
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

enum PaymentStatus {
  PAID
  PARTIAL_REFUNDED
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  CARD
  TRANSFER
  CASH
  OTHER
}

enum PayerType {
  GUARDIAN
  ORGANIZATION // ADR-005: 기관 도입 전까지는 사용하지 않음
}

enum RefundReason {
  PERSONAL
  ILLNESS
  WEATHER
  SCHEDULE
  DUPLICATE_PAYMENT
  CLASS_CANCELLED
  OPERATION
  OTHER
}

enum RefundStatus {
  REQUESTED
  COMPLETED
  CANCELLED
}

// ─────────────────────────────────────────────
// User
// ─────────────────────────────────────────────

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  name               String
  password           String? // Auth.js Credentials 사용 시. OAuth 도입 시 Account/Session 모델 추가 필요
  role               Role     @default(ADMIN)
  isActive           Boolean  @default(true)
  teacherId          String?  @unique
  mustChangePassword Boolean  @default(false)
  authVersion        Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  cancelledClasses        ClassSchedule[]     @relation("ClassCancelledBy")
  cancelledReservations   Reservation[]       @relation("ReservationCancelledBy")
  processedRefunds        Refund[]            @relation("RefundProcessedBy")
  safetyInfoUpdates       ChildSafetyInfo[]   @relation("SafetyInfoUpdatedBy")
  consentRecords          ChildConsent[]      @relation("ConsentRecordedBy")
  attendanceRecords       Reservation[]       @relation("AttendanceRecordedBy")
  teacher                 Teacher?            @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  accountChanges          UserAccountChange[] @relation("AccountChangeTarget")
  performedAccountChanges UserAccountChange[] @relation("AccountChangeActor")
  issuedApplicationLinks       ReservationApplicationLink[] @relation("ApplicationLinkIssuedBy")
  depositConfirmedApplications ReservationApplication[]     @relation("ApplicationDepositConfirmedBy")
  resolvedApplications         ReservationApplication[]     @relation("ApplicationResolvedBy")
  purgedApplications           ReservationApplication[]     @relation("ApplicationPersonalDataPurgedBy")
  purgedChildren               Child[]                      @relation("ChildPersonalDataPurgedBy")
}

model UserAccountChange {
  id               String                @id @default(cuid())
  targetUserId     String
  actorAdminId     String
  type             UserAccountChangeType
  previousEmail    String?
  nextEmail        String?
  previousRole     Role?
  nextRole         Role?
  previousIsActive Boolean?
  nextIsActive     Boolean?
  createdAt        DateTime              @default(now())

  targetUser User @relation("AccountChangeTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  actorAdmin User @relation("AccountChangeActor", fields: [actorAdminId], references: [id], onDelete: Restrict)

  @@index([targetUserId, createdAt])
  @@index([actorAdminId, createdAt])
}

// ─────────────────────────────────────────────
// Child — 기본 고객 단위 (ADR-001)
// ─────────────────────────────────────────────

model Child {
  id            String    @id @default(cuid())
  name          String
  birthDate     DateTime? @db.Date
  gender        Gender    @default(UNSPECIFIED)
  guardianName  String?
  guardianPhone String?
  memo          String?
  isActive      Boolean   @default(true)
  registeredAt  DateTime  @default(now())
  // 마지막 예약 수업일로부터 5년이 지나 개인정보를 비식별화한 시각 (ADR-057). 행은 예약·결제 무결성을 위해 남긴다
  personalDataPurgedAt   DateTime?
  personalDataPurgedById String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  personalDataPurgedBy User?            @relation("ChildPersonalDataPurgedBy", fields: [personalDataPurgedById], references: [id], onDelete: Restrict)
  safetyInfo       ChildSafetyInfo?
  consents         ChildConsent[]
  reservations     Reservation[]
  relationshipsAsA Relationship[]   @relation("RelationshipChildA")
  relationshipsAsB Relationship[]   @relation("RelationshipChildB")
  reservationApplications ReservationApplication[]

  @@index([name])
  @@index([guardianPhone])
  @@index([isActive])
  @@index([personalDataPurgedAt])
}

// 민감정보. 목록 조회에 include 하지 않는다 (ADR-006)
model ChildSafetyInfo {
  id                     String   @id @default(cuid())
  childId                String   @unique
  allergies              String?
  emergencyNotes         String? // 현장에서 즉시 알아야 할 사항에 한정. 진단명/병력/복용약 이력 금지
  emergencyContactName   String?
  emergencyContactPhone  String?
  emergencyContactRelation String?
  updatedById            String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  child       Child @relation(fields: [childId], references: [id], onDelete: Cascade)
  updatedBy   User? @relation("SafetyInfoUpdatedBy", fields: [updatedById], references: [id])
}

// append-only 이력. 동의/철회할 때마다 새 행을 쌓는다.
// 현재 상태 = 해당 consentType 의 recordedAt 최신 행. 기존 행을 수정하거나 삭제하지 않는다.
model ChildConsent {
  id           String        @id @default(cuid())
  childId      String
  consentType  ConsentType
  action       ConsentAction
  recordedAt   DateTime      @default(now())
  memo         String?
  createdAt    DateTime      @default(now())
  recordedById String?
  // Phase 18: 보호자가 온라인 예약 신청에서 동의한 기록이면 출처 신청을 가리킨다 (ADR-054)
  reservationApplicationId String?

  child                  Child                   @relation(fields: [childId], references: [id], onDelete: Cascade)
  recordedBy             User?                   @relation("ConsentRecordedBy", fields: [recordedById], references: [id])
  reservationApplication ReservationApplication? @relation(fields: [reservationApplicationId], references: [id], onDelete: Restrict)

  @@index([childId, consentType, recordedAt])
  @@index([reservationApplicationId])
}

// 아이 간 관계. 양방향 중복 방지를 위해 항상 childAId < childBId 로 정렬 저장
model Relationship {
  id        String           @id @default(cuid())
  childAId  String
  childBId  String
  type      RelationshipType
  createdAt DateTime         @default(now())

  childA Child @relation("RelationshipChildA", fields: [childAId], references: [id], onDelete: Cascade)
  childB Child @relation("RelationshipChildB", fields: [childBId], references: [id], onDelete: Cascade)

  @@unique([childAId, childBId, type])
  @@index([childAId])
  @@index([childBId])
}

// ─────────────────────────────────────────────
// Teacher / Program / ClassSchedule
// ─────────────────────────────────────────────

model Teacher {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  memo      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes ClassTeacher[]
  user    User?
}

model Program {
  id              String        @id @default(cuid())
  name            String
  description     String?
  targetAgeMin    Int?
  targetAgeMax    Int?
  defaultDuration Int? // 분 단위
  defaultPrice    Int           @default(0) // KRW
  status          ProgramStatus @default(ACTIVE)
  memo            String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  classes ClassSchedule[]

  @@index([status])
}

model ClassSchedule {
  id        String      @id @default(cuid())
  programId String
  startsAt  DateTime // UTC 저장, KST 표시
  endsAt    DateTime
  location  String
  capacity  Int         @default(8) // ADR-044: 앱은 1~99 검증, DB 는 1 이상만 보장
  status    ClassStatus @default(SCHEDULED)
  memo      String?

  // 클래스 전체 취소 (ADR-002)
  cancelledAt     DateTime?
  cancelReason    ClassCancelReason?
  cancelDetail    String?
  cancelledById   String?

  // 클래스 단위 안전 정보 (요구사항 20-1.5)
  insured        Boolean @default(false)
  insurer        String?
  insurancePolicyNo String?
  safetyMemo     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  program      Program        @relation(fields: [programId], references: [id])
  cancelledBy  User?          @relation("ClassCancelledBy", fields: [cancelledById], references: [id])
  teachers     ClassTeacher[]
  reservations Reservation[]
  applicationLink ReservationApplicationLink?
  applications    ReservationApplication[]

  @@index([startsAt])
  @@index([status])
  @@index([programId])
}

model ClassTeacher {
  id              String   @id @default(cuid())
  classScheduleId String
  teacherId       String
  createdAt       DateTime @default(now())

  classSchedule ClassSchedule @relation(fields: [classScheduleId], references: [id], onDelete: Cascade)
  teacher       Teacher       @relation(fields: [teacherId], references: [id])

  @@unique([classScheduleId, teacherId])
}

// ─────────────────────────────────────────────
// Reservation — 아이 1명 단위 (ADR-001, ADR-003)
// ─────────────────────────────────────────────

model Reservation {
  id                     String            @id @default(cuid())
  childId                String
  classScheduleId        String
  status                 ReservationStatus @default(RESERVED)
  attendance             AttendanceStatus?
  attendanceRecordedById String?
  attendanceRecordedAt   DateTime?
  reservedAt             DateTime          @default(now())
  memo                   String?

  // 개인 예약 취소 (클래스 전체 취소와 구분)
  cancelledAt   DateTime?
  cancelReason  ReservationCancelReason?
  cancelDetail  String?
  cancelledById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  child                Child         @relation(fields: [childId], references: [id])
  classSchedule        ClassSchedule @relation(fields: [classScheduleId], references: [id])
  cancelledBy          User?         @relation("ReservationCancelledBy", fields: [cancelledById], references: [id])
  attendanceRecordedBy User?         @relation("AttendanceRecordedBy", fields: [attendanceRecordedById], references: [id])
  paymentItem          PaymentItem?
  applications         ReservationApplication[]

  @@unique([classScheduleId, childId])
  @@index([childId])
  @@index([status])
  @@index([cancelledAt])
}

// ─────────────────────────────────────────────
// ReservationApplication — 예약 확정 전 보호자 신청 (Phase 18, ADR-052~054)
// 신청은 Reservation 이 아니다. 좌석을 점유하지 않으며 ADMIN 이 입금 확인 후
// 기존 예약 생성 규칙(createReservationCore)으로 확정한다.
// ─────────────────────────────────────────────

// 클래스별 공개 신청 링크(클래스당 1개). 토큰을 ClassSchedule 컬럼으로 두지 않아
// 기존 클래스 조회 결과(MANAGER/TEACHER payload 포함)에 섞이지 않게 한다.
model ReservationApplicationLink {
  id              String   @id @default(cuid())
  classScheduleId String   @unique
  token           String   @unique
  isActive        Boolean  @default(true)
  issuedAt        DateTime @default(now())
  issuedById      String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  classSchedule ClassSchedule @relation(fields: [classScheduleId], references: [id], onDelete: Restrict)
  issuedBy      User          @relation("ApplicationLinkIssuedBy", fields: [issuedById], references: [id], onDelete: Restrict)
}

model ReservationApplication {
  id                          String                       @id @default(cuid())
  classScheduleId             String
  status                      ReservationApplicationStatus @default(SUBMITTED)
  // 개인정보 항목은 보관기간 만료 후 파기(NULL)될 수 있다. 파기 전에는 CHECK 로 모두 필수다 (ADR-055)
  childName                   String?
  childBirthDate              DateTime?                    @db.Date
  childGender                 Gender?
  guardianName                String?
  guardianPhone               String?
  guardianRelationship        GuardianRelationship?
  requestNote                 String?
  programTermsAcknowledged    Boolean // [필수] 프로그램 안전 및 이용사항 확인
  privacyConsentAgreed        Boolean // [필수] 개인정보 수집·이용 동의
  legalGuardianConfirmed      Boolean // [필수] 법정대리인 확인
  refundTermsAcknowledged     Boolean // [필수] 취소 및 환불규정 확인 (ADR-056)
  photoShareConsentAgreed     Boolean // [선택] 활동 사진·영상 촬영 및 참여 보호자 공유
  photoMarketingConsentAgreed Boolean // [선택] 사진·영상 YAHO 홍보 활용
  consentVersion              String // 제출 당시 보여준 동의 문구 버전
  submittedAt                 DateTime                     @default(now())
  depositConfirmedAt          DateTime?
  depositConfirmedById        String?
  resolvedAt                  DateTime? // 확정·반려·취소 처리 시각
  resolvedById                String?
  resolutionNote              String? // 반려·취소 사유
  childId                     String? // 확정 시 연결한 아이
  reservationId               String? // 확정 시 생성·재활성화한 예약. ADR-024 재예약 때문에 unique 가 아니다
  personalDataPurgedAt        DateTime? // 보관기간 만료로 개인정보를 파기한 시각 (ADR-055)
  personalDataPurgedById      String?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt

  classSchedule        ClassSchedule  @relation(fields: [classScheduleId], references: [id], onDelete: Restrict)
  depositConfirmedBy   User?          @relation("ApplicationDepositConfirmedBy", fields: [depositConfirmedById], references: [id], onDelete: Restrict)
  resolvedBy           User?          @relation("ApplicationResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict)
  personalDataPurgedBy User?          @relation("ApplicationPersonalDataPurgedBy", fields: [personalDataPurgedById], references: [id], onDelete: Restrict)
  child              Child?         @relation(fields: [childId], references: [id], onDelete: Restrict)
  reservation        Reservation?   @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  consents           ChildConsent[]

  @@index([status, submittedAt])
  @@index([classScheduleId, status])
  @@index([childId])
  @@index([reservationId])
  @@index([personalDataPurgedAt])
}

// ─────────────────────────────────────────────
// Payment / PaymentItem / Refund (ADR-005)
// ─────────────────────────────────────────────

// 결제 1건. 현재는 PaymentItem 1건만 붙지만, 기관 일괄 결제 시 N건이 된다
model Payment {
  id          String        @id @default(cuid())
  payerType   PayerType     @default(GUARDIAN)
  payerName   String?
  method      PaymentMethod
  status      PaymentStatus @default(PAID)
  paidAt      DateTime      @default(now())
  totalAmount Int // 각 item 의 paidAmount 합계
  memo        String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  items PaymentItem[]

  @@index([paidAt])
  @@index([status])
}

// 예약별 청구 명세. 매출 집계는 반드시 이 테이블 기준으로 한다
model PaymentItem {
  id             String   @id @default(cuid())
  paymentId      String
  reservationId  String   @unique
  amount         Int // 정가
  discountAmount Int      @default(0)
  paidAmount     Int // amount - discountAmount
  refundedAmount Int      @default(0) // 환불 누계. Refund 생성/취소 시 같은 트랜잭션에서 갱신한다
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  payment     Payment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  reservation Reservation @relation(fields: [reservationId], references: [id])
  refunds     Refund[]

  @@index([paymentId])
}

model Refund {
  id            String       @id @default(cuid())
  paymentItemId String
  amount        Int
  reason        RefundReason
  reasonDetail  String?
  status        RefundStatus @default(COMPLETED)
  refundedAt    DateTime     @default(now())
  processedById String?
  createdAt     DateTime     @default(now())

  paymentItem PaymentItem @relation(fields: [paymentItemId], references: [id])
  processedBy User?       @relation("RefundProcessedBy", fields: [processedById], references: [id])

  @@index([paymentItemId])
  @@index([refundedAt])
}

